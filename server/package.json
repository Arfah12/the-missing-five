{
  "name": "@tmf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative multiplayer server for THE MISSING FIVE (Express + Socket.IO).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tmf/shared": "*",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.4",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
