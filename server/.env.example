# Copy to `server/.env` only if you need to change the defaults (it is loaded on start).
# On Render/Railway set these in the dashboard instead.

# Port the server listens on (hosting platforms usually set PORT for you).
PORT=3001

# Comma-separated list of web origins allowed to connect when the client is
# hosted somewhere else, e.g. on Vercel:
# CLIENT_ORIGIN=https://the-missing-five.vercel.app
CLIENT_ORIGIN=

# Serve the built client (client/dist) from this server. Default: on in production.
# SERVE_CLIENT=true

# debug | info | warn | error
LOG_LEVEL=info
